# Navori 分布式执行 agent 配置（.env 风格；环境变量优先）
# 在「执行器」页创建同名 agent，token 只显示一次；每台 agent 的 name/token 必须唯一。
# 能力标签（build=true / deploy=true）与 region/cluster 等路由标签在页面登记，server 为准。
NAVORI_URL=https://navori.example.com
AGENT_TOKEN=replace-with-one-time-token
AGENT_NAME=agent-1
# 工作目录：workspace 与 docker-config 都在其下
AGENT_WORKDIR=/var/lib/navori-agent
# 并发执行的步骤数
AGENT_CONCURRENCY=1
# 仅自签名证书的内网 server 才设为 true
AGENT_INSECURE_SKIP_VERIFY=false
