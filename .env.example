# Navori 配置
#
# 配置来源（优先级从高到低）：
#   1. 环境变量（本文件，或 K8s Secret / docker run -e）
#   2. 配置文件（JSON）：NAVORI_CONFIG 指定的路径，默认 ./navori.json 或
#      /etc/navori/navori.json。字段名 = 环境变量名小写（snake_case），
#      见 examples/navori.example.json
#   env 非空时覆盖配置文件。
#
# 生产建议：MASTER_KEY 与 JWT_SECRET 务必显式设置（否则首启自动生成并
# 持久化到 DATA_DIR 下；K8s 下若 DATA_DIR 不挂 PVC，重启会重新生成，
# 导致已存凭据无法解密 / 全部会话失效）。

PORT=3000

# 数据库：sqlite（默认）或 mysql
DB_DRIVER=sqlite
DB_PATH=data/navori.db
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/navori?charset=utf8mb4&parseTime=True&loc=Local

# 数据目录（master key / jwt secret / 工作区 / 日志）
DATA_DIR=data

# AES-256-GCM 主密钥（32 字节 hex，生成：openssl rand -hex 32）
# 留空 = 首启自动生成并持久化到 DATA_DIR/master.key
MASTER_KEY=

# 认证
JWT_SECRET=          # 留空自动生成并持久化到 data/jwt.secret（建议显式设置）
JWT_EXPIRES_IN=168h
ADMIN_USER=admin
ADMIN_PASSWORD=      # 留空首启自动生成（打印到日志）

# 对外地址（webhook URL 展示用）
BASE_URL=http://localhost:3000

# 运行时
RUN_RETENTION=10         # 每流水线保留最近 N 次 run
HEALTH_CHECK_INTERVAL=5  # 镜像仓库/部署环境健康检测间隔（分钟）

# 配置文件路径（可选；也可用默认 ./navori.json 或 /etc/navori/navori.json）
# NAVORI_CONFIG=/etc/navori/navori.json
