# Navori 配置文件示例
# 本文件即 KEY=VALUE 风格，可直接作为 -config 配置文件使用：
#   cp .env.example navori.env && ./navori -config navori.env
# 或放入 /etc/navori/navori.env（不带 -config 时自动探测 ./navori.env → /etc/navori/navori.env）
# 未显式设置时自动探测；也可完全不使用文件，全部用环境变量。
# 优先级：环境变量 > 配置文件 > 默认值（环境变量非空时覆盖文件）。
# 支持 # 注释、export 前缀、引号包裹的值。

PORT=3000

# 数据库：sqlite（默认）或 mysql
DB_DRIVER=sqlite
DB_PATH=data/navori.db
# DB_DSN=user:pass@tcp(127.0.0.1:3306)/navori?charset=utf8mb4&parseTime=True&loc=Local

# 数据目录（仓库缓存 / run 日志；密钥也可放此处，见下）
# 注意：容器内建议用绝对路径 DATA_DIR=/data（镜像 WORKDIR 是 /data）；
# 裸机用相对路径 data 亦可。
DATA_DIR=data

# AES-256-GCM 主密钥（32 字节 hex，生成：openssl rand -hex 32）
# 生产强烈建议显式设置（否则首启自动生成并写入 DATA_DIR/master.key）
MASTER_KEY=

# 认证
JWT_SECRET=          # 生产建议显式设置（否则自动生成并写入 DATA_DIR/jwt.secret）
JWT_EXPIRES_IN=168h
ADMIN_USER=admin
ADMIN_PASSWORD=      # 留空首启自动生成（打印到日志）

# 对外地址（webhook URL 展示用）
BASE_URL=http://localhost:3000

# 运行时
RUN_RETENTION=10         # 每流水线保留最近 N 次 run
HEALTH_CHECK_INTERVAL=5  # 镜像仓库/部署环境健康检测间隔（分钟）
